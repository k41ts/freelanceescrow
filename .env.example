# Salin file ini menjadi .env lalu isi nilainya. JANGAN commit .env.

# RPC Sepolia - Infura atau Alchemy free tier sudah cukup
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/ISI_PROJECT_ID_ANDA

# Private key wallet SEKALI PAKAI untuk deploy.
# JANGAN PERNAH memakai private key wallet yang memegang aset asli.
PRIVATE_KEY=0xisi_private_key_wallet_throwaway

# Untuk verify source code di Sepolia Etherscan (opsional tapi disarankan)
ETHERSCAN_API_KEY=
