# Salin menjadi frontend/.env lalu isi. JANGAN commit .env.

# Alamat contract hasil `npm run deploy:sepolia` di root project
VITE_CONTRACT_ADDRESS=0x...

# Pinata JWT untuk upload bukti kerja ke IPFS (API v3).
#
# Cara ambil: dashboard Pinata > API Keys > New Key.
# JANGAN pilih Admin. Pilih scoped key, centang HANYA izin:
#     org:files:write
# Lalu salin nilai JWT-nya, bukan API Key atau API Secret.
#
# PENTING: nilai ini ikut ter-bundle dan terbaca publik di browser.
# Itu sebabnya izinnya dibatasi hanya menulis file, supaya key yang bocor
# tidak bisa menghapus atau membaca isi akun Pinata.
VITE_PINATA_JWT=

# Gateway untuk membuka file berdasarkan CID (opsional)
VITE_PINATA_GATEWAY=https://gateway.pinata.cloud
