# Salin menjadi frontend/.env lalu isi. JANGAN commit .env.

# Alamat contract hasil `npm run deploy:sepolia` di root project
VITE_CONTRACT_ADDRESS=0x...

# Pinata JWT untuk upload bukti kerja ke IPFS.
# PENTING: nilai ini ikut ter-bundle dan terbaca publik di browser.
# Gunakan scoped key dengan izin UPLOAD SAJA, jangan admin key.
VITE_PINATA_JWT=

# Gateway untuk membuka file berdasarkan CID (opsional)
VITE_PINATA_GATEWAY=https://gateway.pinata.cloud
